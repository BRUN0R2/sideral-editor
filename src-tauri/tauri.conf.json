{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sideral Editor",
  "version": "0.1.1",
  "identifier": "dev.sideral.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sideral Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "devtools": false,
        "zoomHotkeysEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#282c34"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' data: blob:; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "resources": {
      "../assets/vscode-theme-seti/THIRD_PARTY_NOTICES.txt": "licenses/vscode-theme-seti.txt"
    },
    "shortDescription": "A focused, native code editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
