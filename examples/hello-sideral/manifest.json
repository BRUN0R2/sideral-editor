{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "sideral.hello",
  "displayName": "Hello Sideral",
  "version": "0.1.0",
  "description": "A minimal extension that demonstrates commands, storage, messages and output.",
  "license": "MIT",
  "engines": {
    "sideral": "^0.1.0"
  },
  "runtime": {
    "kind": "worker",
    "entry": "dist/extension.mjs"
  },
  "contributes": {
    "commands": [
      {
        "id": "sideral.hello.greet",
        "title": "Say hello",
        "category": "Hello Sideral"
      }
    ]
  }
}
