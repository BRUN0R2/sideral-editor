{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "sideral.markdown-preview",
  "displayName": "Sideral Markdown Preview",
  "version": "0.1.0",
  "description": "A secure, responsive Markdown preview powered by the native Sideral preview surface.",
  "license": "MIT",
  "engines": {
    "sideral": "^0.1.0"
  },
  "runtime": {
    "kind": "worker",
    "entry": "dist/extension.mjs"
  },
  "permissions": {
    "workspace": "read"
  },
  "contributes": {
    "commands": [
      {
        "id": "sideral.markdown-preview.toggle",
        "title": "Toggle Markdown Preview",
        "category": "Markdown",
        "invocation": "activeTextDocument"
      }
    ],
    "keybindings": [
      {
        "command": "sideral.markdown-preview.toggle",
        "key": "Ctrl+Shift+V",
        "mac": "Shift+Meta+V",
        "languages": ["markdown"]
      }
    ]
  }
}
